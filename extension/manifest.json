{
  "manifest_version": 3,
  "name": "KOI//OS Cart",
  "version": "1.0.0",
  "description": "Adds KOI//OS order sheet lines to distributor carts in your own logged-in browser.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://koi-os-app.onrender.com/*",
    "https://www.pacificsmoke.com/*",
    "https://pacificsmoke.com/*",
    "https://www.valordistributions.com/*",
    "https://valordistributions.com/*",
    "https://nimbusdistro.ca/*",
    "https://globe11.com/*",
    "https://gcorecanada.com/*",
    "https://www.gcorecanada.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://koi-os-app.onrender.com/*", "http://localhost/*"],
      "js": ["koi.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "128": "icon.png" }
}
