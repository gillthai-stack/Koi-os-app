// KOI//OS database. Postgres (Neon) in every environment.
// DATABASE_URL comes from the environment; see README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify login sessions (managed by @shopify/shopify-app-session-storage-prisma).
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum Stamp {
  ONTARIO
  FEDERAL
}

enum Role {
  OWNER
  STAFF
}

// People who can sign in to the KOI//OS web app. Created by the owner.
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  displayName  String
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// Per-item ordering settings that Shopify doesn't hold (one row per variant).
model VariantSetting {
  variantId  String   @id // Shopify product variant GID
  cartonSize Int      @default(5) // pieces per carton
  stamp      Stamp?
  updatedAt  DateTime @updatedAt
  updatedBy  String?
}

// Maps a Shopify vendor to the distributor we order it from and that distributor's ordering site.
model DistributorLink {
  vendor      String   @id // Shopify product vendor
  distributor String
  url         String
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

enum QtyUnit {
  CARTON
  PIECE
}

// The product page on the distributor's site for one of our flavours, used to fill their cart.
model DistroProduct {
  variantId String   @id // Shopify product variant GID
  url       String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Per-distributor ordering settings.
model DistributorSetting {
  distributor String   @id
  qtyUnit     QtyUnit
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}
